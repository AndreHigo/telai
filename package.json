{
  "name": "telai",
  "version": "0.2.68",
  "author": "Telai",
  "private": true,
  "description": "Telai: transmissões privadas de tela, câmera e jogos.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "start:postgres": "node qa/start-postgres.mjs",
    "desktop": "electron .",
    "dev:frontend": "vite --config vite.config.js",
    "build:frontend": "vite build --config vite.config.js",
    "test:api": "node qa/run-api.cjs",
    "test:api-client": "node qa/test-api-client.mjs",
    "test:api-types": "tsc -p frontend/tsconfig.json --noEmit",
    "test:auth-controller": "node qa/test-auth-controller.mjs",
    "test:auth-guards": "node qa/test-auth-guards.mjs",
    "test:navigation": "node qa/test-navigation-controller.mjs",
    "test:viewport-controller": "node qa/test-viewport-controller.mjs",
    "test:route-controller": "node qa/test-route-controller.mjs",
    "test:client-polling": "node qa/test-client-polling.mjs",
    "test:release-notes": "node qa/test-release-notes-controller.mjs",
    "test:broadcast-audio-bridge": "node qa/test-broadcast-audio-bridge.mjs",
    "test:broadcast-audio-mixer": "node qa/test-broadcast-audio-mixer.mjs",
    "test:broadcast-capture": "node qa/test-broadcast-capture-controller.mjs",
    "test:broadcast-track": "node qa/test-broadcast-track-controller.mjs",
    "test:events": "node qa/e2e-events.cjs",
    "test:events-ui": "electron --no-sandbox qa/e2e-events-ui.cjs",
    "test:voice-activity": "node qa/test-voice-activity.cjs",
    "test:voice-sound-controller": "node qa/test-voice-sound-controller.mjs",
    "test:rtc-quality": "node qa/test-rtc-quality.mjs",
    "test:voice-quality-controller": "node qa/test-voice-quality-controller.mjs",
    "test:voice-reconnect-storage": "node qa/test-voice-reconnect-storage.mjs",
    "test:media-contract": "node qa/test-media-contract.mjs",
    "test:group-controller": "node qa/test-group-controller.mjs",
    "test:group-room-read-controller": "node qa/test-group-room-read-controller.mjs",
    "test:group-event-runtime": "node qa/test-group-event-runtime.mjs",
    "test:group-thread-runtime": "node qa/test-group-thread-runtime.mjs",
    "test:voice-signaling-controller": "node qa/test-voice-signaling-controller.mjs",
    "test:voice-peer-health-controller": "node qa/test-voice-peer-health-controller.mjs",
    "test:voice-peer-recovery-controller": "node qa/test-voice-peer-recovery-controller.mjs",
    "test:sqlite-legacy-compatibility": "node qa/test-sqlite-legacy-compatibility.mjs",
    "test:security": "node qa/e2e-rate-limit.cjs",
    "test:settings-navigation-controller": "node qa/test-settings-navigation-controller.mjs",
    "test:notifications": "electron --no-sandbox qa/e2e-notifications.cjs",
    "test:notification-service": "node qa/test-notification-service.mjs",
    "test:web-audit": "electron --no-sandbox qa/e2e-web-audit.cjs",
    "test:media": "electron --no-sandbox qa/e2e-media.cjs",
    "test:voice-reconnect": "electron --no-sandbox qa/e2e-voice-reconnect.cjs",
    "test:seo": "node qa/e2e-seo.cjs",
    "test:admin": "node qa/e2e-admin.cjs",
    "test:tray": "electron --no-sandbox qa/e2e-tray.cjs",
    "generate:tray-icons": "electron --no-sandbox qa/generate-tray-icons.cjs",
    "test:observability": "node qa/e2e-observability.cjs",
    "test:observability-runtime": "node qa/test-observability-runtime.mjs",
    "test:request-context": "node qa/test-request-context.mjs",
    "db:migrate:postgres": "node qa/migrate-postgres.mjs",
    "db:import:postgres": "node qa/import-sqlite-to-postgres.mjs",
    "db:test:postgres-import": "node qa/test-postgres-import.mjs",
    "db:test:postgres-migration": "node qa/validate-postgres-migration.mjs",
    "db:test:postgres-migration-concurrency": "node qa/test-postgres-migration-concurrency.mjs",
    "db:test:postgres-repositories": "node qa/test-postgres-repositories.mjs",
    "db:test:postgres-maintenance": "node qa/test-postgres-maintenance.cjs",
    "db:test:postgres-api": "node qa/run-api-postgres.cjs",
    "db:test:postgres-suite": "node qa/test-postgres-suite.mjs",
    "dist": "npm run build:frontend && electron-builder --win nsis"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/svelte": "^1.1.5",
    "@kokapuk/application-loopback": "1.0.2",
    "electron-updater": "6.8.9",
    "loopback-capture": "3.0.2",
    "nodemailer": "^10.0.10",
    "pg": "8.16.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.mirante.share",
    "productName": "Telai",
    "npmRebuild": false,
    "icon": "public/telai-app-icon.png",
    "files": [
      "electron/**/*",
      "server.mjs",
      "public/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Telai-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "AndreHigo",
      "repo": "telai-downloads",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
