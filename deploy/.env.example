HOST=0.0.0.0
PORT=8787
MEDIA_MODE=p2p
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_SECRET=
TURN_REALM=telai.tv.br
TURN_EXTERNAL_IP=
PUBLIC_BASE_URL=
REQUIRE_LOGIN=true
# Relay SMTP transacional. O remetente precisa estar verificado no provedor.
SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@telai.tv.br
SMTP_REPLY_TO=suporte@telai.tv.br
SMTP_TIMEOUT_MS=15000
HOST_RECONNECT_GRACE_MS=45000
MIRANTE_LOGIN_RATE_LIMIT_PER_MIN=12
# Proteção HTTP por IP. O limite de API não deve ser reduzido abaixo de 30.
MIRANTE_API_RATE_LIMIT_PER_MIN=240
MIRANTE_API_WRITE_RATE_LIMIT_PER_MIN=90
# Teto agregado por IP; os limites acima são separados por rota.
MIRANTE_API_GLOBAL_RATE_LIMIT_PER_MIN=900
MIRANTE_REGISTER_RATE_LIMIT=5
MIRANTE_OAUTH_RATE_LIMIT=20
MIRANTE_LOGIN_FAILURE_LIMIT=5
MIRANTE_LOGIN_FAILURE_IP_LIMIT=30
MIRANTE_WS_CONNECTION_RATE_LIMIT=30
MIRANTE_WS_ACTIVE_CONNECTION_LIMIT=20
MIRANTE_ALLOWED_ORIGINS=
TELAI_MAINTENANCE_TOKEN=replace-with-another-long-random-secret
# Logs JSON estruturados: info em produção; use debug temporariamente para investigar falhas.
MIRANTE_LOG_LEVEL=info
# Opcional: caminho de um arquivo JSONL fora de public/ (o stdout continua recebendo os logs).
MIRANTE_LOG_PATH=
MIRANTE_DB_PATH=/data/mirante-tv.sqlite
# Opcional: sobrescreva o nome/caminho do instalador Windows.
# Por padrão, o nome acompanha a versão do package.json.
MIRANTE_DESKTOP_ARTIFACT_PATH=
MIRANTE_DESKTOP_ARTIFACT_NAME=
MIRANTE_DESKTOP_DOWNLOAD_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
