DOMAIN=share.example.com
MEDIA_MODE=p2p
HOST_RECONNECT_GRACE_MS=45000
MIRANTE_LOGIN_RATE_LIMIT_PER_MIN=12
MIRANTE_API_RATE_LIMIT_PER_MIN=240
MIRANTE_API_WRITE_RATE_LIMIT_PER_MIN=90
MIRANTE_API_GLOBAL_RATE_LIMIT_PER_MIN=900
MIRANTE_REGISTER_RATE_LIMIT=5
MIRANTE_OAUTH_RATE_LIMIT=20
MIRANTE_LOGIN_FAILURE_LIMIT=5
MIRANTE_LOGIN_FAILURE_IP_LIMIT=30
MIRANTE_WS_CONNECTION_RATE_LIMIT=30
MIRANTE_WS_ACTIVE_CONNECTION_LIMIT=20
MIRANTE_ALLOWED_ORIGINS=
# Acesso ao painel privado de operação. Informe username(s) ou ID(s) separados por vírgula.
# Sem uma allowlist configurada, nenhuma conta consegue acessar /admin.
TELAI_ADMIN_USERNAMES=
TELAI_ADMIN_USER_IDS=
# Segredo usado pelo script de atualização para anunciar manutenção antes do deploy.
TELAI_MAINTENANCE_TOKEN=replace-with-another-long-random-secret
# Ative temporariamente como debug durante uma reprodução e volte para info depois.
MIRANTE_LOG_LEVEL=info
TELAI_LEGAL_POLICY_VERSION=2026-09-08
TURN_SECRET=replace-with-a-long-random-secret
MIRANTE_DB_PATH=/data/mirante-tv.sqlite
# Relay SMTP transacional; use as credenciais do provedor, não as do SSH.
SMTP_ENABLED=true
SMTP_HOST=smtp.sender.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@telai.tv.br
SMTP_REPLY_TO=suporte@telai.tv.br
SMTP_TIMEOUT_MS=15000
