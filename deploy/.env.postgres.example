# Este arquivo prepara o PostgreSQL local; o servidor ainda usa SQLite até a
# conversão dos repositórios e a validação do importador.
TELAI_DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://telai:replace-with-a-local-password@127.0.0.1:5432/telai
TELAI_DATABASE_POOL_MAX=10
DATABASE_SSL=disable

TELAI_POSTGRES_DB=telai
TELAI_POSTGRES_USER=telai
TELAI_POSTGRES_PASSWORD=replace-with-a-local-password
TELAI_POSTGRES_PORT=5432
